generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum RoleAssignmentSource {
  SYSTEM_SEED
  ADMIN
}

enum VesselStatus {
  ACTIVE
  ARCHIVED
}

enum ComplianceConditionStatus {
  MISSING
  EXPIRED
  EXPIRING_SOON
}

enum NotificationJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum CertificateDocumentStatus {
  QUARANTINED
  AVAILABLE
  REJECTED
  DELETED
}

enum DocumentScanResult {
  PENDING
  NO_THREATS_FOUND
  THREATS_FOUND
  FAILED
}

model User {
  id                           String                      @id @default(uuid()) @db.Uuid
  externalSubject              String                      @unique @map("external_subject")
  displayName                  String                      @map("display_name")
  email                        String
  status                       UserStatus                  @default(ACTIVE)
  createdAt                    DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  roleAssignments              UserRoleAssignment[]        @relation("AssignedUser")
  assignmentsMade              UserRoleAssignment[]        @relation("AssignedBy")
  vesselsCreated               Vessel[]                    @relation("VesselCreatedBy")
  certificatesCreated          Certificate[]               @relation("CertificateCreatedBy")
  auditEvents                  AuditEvent[]                @relation("AuditEventActor")
  notificationRuns             ComplianceNotificationRun[] @relation("NotificationRunTriggeredBy")
  certificateDocumentsUploaded CertificateDocument[]       @relation("CertificateDocumentUploadedBy")
  crewMembersCreated           CrewMember[]                @relation("CrewMemberCreatedBy")
  qualificationsCreated        CrewQualification[]         @relation("QualificationCreatedBy")
  crewAssignmentsCreated       CrewAssignment[]            @relation("CrewAssignmentCreatedBy")
  crewAssignmentsCancelled     CrewAssignment[]            @relation("CrewAssignmentCancelledBy")
  maintenanceAssigned          MaintenanceOrder[]          @relation("MaintenanceAssignee")
  maintenanceCreated           MaintenanceOrder[]          @relation("MaintenanceCreatedBy")

  @@map("users")
}

model Role {
  id          String               @id @default(uuid()) @db.Uuid
  code        String               @unique
  name        String
  assignments UserRoleAssignment[]

  @@map("roles")
}

model CrewMember {
  id             String              @id @default(uuid()) @db.Uuid
  displayName    String              @map("display_name")
  crewNumber     String              @unique @map("crew_number")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById    String              @map("created_by_id") @db.Uuid
  createdBy      User                @relation("CrewMemberCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  qualifications CrewQualification[]
  assignments    CrewAssignment[]

  @@map("crew_members")
}

enum QualificationKind {
  DEMO_SAFETY
  DEMO_DECK
}

model CrewQualification {
  id              String            @id @default(uuid()) @db.Uuid
  crewMemberId    String            @map("crew_member_id") @db.Uuid
  kind            QualificationKind
  referenceNumber String            @map("reference_number")
  validFrom       DateTime          @map("valid_from") @db.Date
  expiresOn       DateTime          @map("expires_on") @db.Date
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById     String            @map("created_by_id") @db.Uuid
  member          CrewMember        @relation(fields: [crewMemberId], references: [id], onDelete: Restrict)
  createdBy       User              @relation("QualificationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([crewMemberId, referenceNumber])
  @@index([crewMemberId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("crew_qualifications")
}

enum CrewAssignmentRole {
  DEMO_DECK
  DEMO_SUPPORT
}

enum CrewAssignmentCancellationReason {
  INCORRECT_RECORD
  PLAN_CHANGED
}

model CrewAssignment {
  id                 String                            @id @default(uuid()) @db.Uuid
  crewMemberId       String                            @map("crew_member_id") @db.Uuid
  vesselId           String                            @map("vessel_id") @db.Uuid
  role               CrewAssignmentRole
  startsOn           DateTime                          @map("starts_on") @db.Date
  endsOn             DateTime                          @map("ends_on") @db.Date
  createdAt          DateTime                          @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById        String                            @map("created_by_id") @db.Uuid
  member             CrewMember                        @relation(fields: [crewMemberId], references: [id], onDelete: Restrict)
  vessel             Vessel                            @relation(fields: [vesselId], references: [id], onDelete: Restrict)
  createdBy          User                              @relation("CrewAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledAt        DateTime?                         @map("cancelled_at") @db.Timestamptz(3)
  cancelledById      String?                           @map("cancelled_by_id") @db.Uuid
  cancellationReason CrewAssignmentCancellationReason? @map("cancellation_reason")
  cancelledBy        User?                             @relation("CrewAssignmentCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)

  @@index([crewMemberId, startsOn, endsOn])
  @@index([vesselId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("crew_assignments")
}

model UserRoleAssignment {
  userId       String               @map("user_id") @db.Uuid
  roleId       String               @map("role_id") @db.Uuid
  assignedAt   DateTime             @default(now()) @map("assigned_at") @db.Timestamptz(3)
  assignedById String?              @map("assigned_by_id") @db.Uuid
  source       RoleAssignmentSource @default(ADMIN)
  user         User                 @relation("AssignedUser", fields: [userId], references: [id], onDelete: Restrict)
  role         Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy   User?                @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_role_assignments")
}

model Vessel {
  id                      String                   @id @default(uuid()) @db.Uuid
  name                    String
  registryNumber          String                   @unique @map("registry_number")
  status                  VesselStatus             @default(ACTIVE)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById             String                   @map("created_by_id") @db.Uuid
  createdBy               User                     @relation("VesselCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  certificates            Certificate[]
  complianceNotifications ComplianceNotification[]
  crewAssignments         CrewAssignment[]
  maintenanceOrders       MaintenanceOrder[]

  @@map("vessels")
}

enum MaintenanceCategory {
  PREVENTIVE
  CORRECTIVE
  INSPECTION
}

enum MaintenancePriority {
  LOW
  NORMAL
  HIGH
}

enum MaintenanceStatus {
  OPEN
  PLANNED
  IN_PROGRESS
  BLOCKED
  CLOSED
  CANCELLED
}

model MaintenanceOrder {
  id           String              @id @default(uuid()) @db.Uuid
  vesselId     String              @map("vessel_id") @db.Uuid
  title        String              @db.VarChar(120)
  category     MaintenanceCategory
  priority     MaintenancePriority
  status       MaintenanceStatus   @default(OPEN)
  assigneeId   String?             @map("assignee_id") @db.Uuid
  targetDate   DateTime?           @map("target_date") @db.Date
  revision     Int                @default(1)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById  String             @map("created_by_id") @db.Uuid
  vessel       Vessel             @relation(fields: [vesselId], references: [id], onDelete: Restrict)
  assignee     User?              @relation("MaintenanceAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy    User               @relation("MaintenanceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([vesselId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("maintenance_orders")
}

model CertificateType {
  id                      String                   @id @default(uuid()) @db.Uuid
  code                    String                   @unique
  name                    String
  isRequired              Boolean                  @default(false) @map("is_required")
  certificates            Certificate[]
  complianceNotifications ComplianceNotification[]

  @@map("certificate_types")
}

model Certificate {
  id                String                @id @default(uuid()) @db.Uuid
  vesselId          String                @map("vessel_id") @db.Uuid
  certificateTypeId String                @map("certificate_type_id") @db.Uuid
  referenceNumber   String                @map("reference_number")
  issuer            String
  issuedOn          DateTime              @map("issued_on") @db.Date
  expiresOn         DateTime              @map("expires_on") @db.Date
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt        DateTime?             @map("archived_at") @db.Timestamptz(3)
  createdById       String                @map("created_by_id") @db.Uuid
  vessel            Vessel                @relation(fields: [vesselId], references: [id], onDelete: Restrict)
  certificateType   CertificateType       @relation(fields: [certificateTypeId], references: [id], onDelete: Restrict)
  createdBy         User                  @relation("CertificateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  documents         CertificateDocument[]

  @@unique([vesselId, certificateTypeId, referenceNumber])
  @@index([vesselId, certificateTypeId, expiresOn(sort: Desc)])
  @@index([vesselId, archivedAt, certificateTypeId, expiresOn(sort: Desc)])
  @@map("certificates")
}

// Retired attachment metadata retained for history. No application upload/download
// or cleanup path uses this model. Do not remove the applied migration or its data.
model CertificateDocument {
  id               String                    @id @default(uuid()) @db.Uuid
  certificateId    String                    @map("certificate_id") @db.Uuid
  storageKey       String                    @unique @map("storage_key")
  originalFileName String                    @map("original_file_name")
  mediaType        String                    @map("media_type")
  sizeBytes        Int                       @map("size_bytes")
  sha256           String                    @db.Char(64)
  status           CertificateDocumentStatus @default(QUARANTINED)
  scanResult       DocumentScanResult        @default(PENDING) @map("scan_result")
  scanProvider     String                    @map("scan_provider")
  failureCode      String?                   @map("failure_code")
  uploadedAt       DateTime                  @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  uploadedById     String                    @map("uploaded_by_id") @db.Uuid
  availableAt      DateTime?                 @map("available_at") @db.Timestamptz(3)
  rejectedAt       DateTime?                 @map("rejected_at") @db.Timestamptz(3)
  deleteAfter      DateTime?                 @map("delete_after") @db.Timestamptz(3)
  objectDeletedAt  DateTime?                 @map("object_deleted_at") @db.Timestamptz(3)
  certificate      Certificate               @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  uploadedBy       User                      @relation("CertificateDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([certificateId, uploadedAt(sort: Desc)])
  @@index([status, uploadedAt])
  @@index([deleteAfter])
  @@map("certificate_documents")
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  actorUserId   String   @map("actor_user_id") @db.Uuid
  action        String
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id") @db.Uuid
  metadata      Json
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  correlationId String   @map("correlation_id")
  actor         User     @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@map("audit_events")
}

model ComplianceNotification {
  id                String                    @id @default(uuid()) @db.Uuid
  vesselId          String                    @map("vessel_id") @db.Uuid
  certificateTypeId String                    @map("certificate_type_id") @db.Uuid
  conditionKey      String                    @map("condition_key")
  status            ComplianceConditionStatus
  reason            String
  asOf              DateTime                  @map("as_of") @db.Date
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt        DateTime?                 @map("resolved_at") @db.Timestamptz(3)
  sourceRunId       String                    @map("source_run_id") @db.Uuid
  vessel            Vessel                    @relation(fields: [vesselId], references: [id], onDelete: Restrict)
  certificateType   CertificateType           @relation(fields: [certificateTypeId], references: [id], onDelete: Restrict)
  sourceRun         ComplianceNotificationRun @relation("NotificationCreatedByRun", fields: [sourceRunId], references: [id], onDelete: Restrict)

  @@index([resolvedAt, createdAt(sort: Desc)])
  @@index([vesselId, resolvedAt])
  @@index([conditionKey, resolvedAt])
  @@index([sourceRunId])
  @@map("compliance_notifications")
}

model ComplianceNotificationRun {
  id                   String                   @id @default(uuid()) @db.Uuid
  jobCode              String                   @default("EXPIRY_NOTIFICATIONS") @map("job_code")
  status               NotificationJobStatus    @default(QUEUED)
  queuedAt             DateTime                 @default(now()) @map("queued_at") @db.Timestamptz(3)
  startedAt            DateTime?                @map("started_at") @db.Timestamptz(3)
  completedAt          DateTime?                @map("completed_at") @db.Timestamptz(3)
  createdCount         Int                      @default(0) @map("created_count")
  skippedCount         Int                      @default(0) @map("skipped_count")
  resolvedCount        Int                      @default(0) @map("resolved_count")
  failureCode          String?                  @map("failure_code")
  triggeredById        String                   @map("triggered_by_id") @db.Uuid
  triggeredBy          User                     @relation("NotificationRunTriggeredBy", fields: [triggeredById], references: [id], onDelete: Restrict)
  notificationsCreated ComplianceNotification[] @relation("NotificationCreatedByRun")

  @@index([queuedAt(sort: Desc)])
  @@index([jobCode, status])
  @@map("compliance_notification_runs")
}
