# Keelwatch environment template
# Copy this file to .env at the repository root. Never commit .env.

# -----------------------------------------------------------------------------
# Server-only values (NestJS and Prisma). Do not expose these with a VITE_ prefix.
# The checked-in defaults run the synthetic local identity and in-memory Access
# store. They do not require Docker or a running PostgreSQL server.
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
AUTH_MODE=local
ACCESS_STORE=memory

# This local-only URL is not contacted while ACCESS_STORE=memory. Replace it with
# a native local or authorized managed PostgreSQL URL before selecting
# ACCESS_STORE=prisma or running migrate/seed commands.
DATABASE_URL=postgresql://keelwatch:keelwatch-local-only@localhost:5432/keelwatch?schema=public

# -----------------------------------------------------------------------------
# Browser-exposed values (Vite). Every VITE_* value is public in the web bundle.
# Keep the browser and API auth modes aligned.
# -----------------------------------------------------------------------------
VITE_AUTH_MODE=local
VITE_API_URL=/api/v1

# -----------------------------------------------------------------------------
# Auth0 / OIDC placeholders. Uncomment and replace all five values together when
# using real OIDC. Keelwatch does not expect an Auth0 client secret: the SPA uses
# a public client with PKCE and the API validates bearer tokens through JWKS.
# -----------------------------------------------------------------------------
# OIDC_ISSUER=https://replace-me.us.auth0.com/
# OIDC_AUDIENCE=https://api.keelwatch.example
# VITE_OIDC_AUTHORITY=https://replace-me.us.auth0.com/
# VITE_OIDC_CLIENT_ID=replace-with-auth0-spa-client-id
# VITE_OIDC_AUDIENCE=https://api.keelwatch.example

# Production-only seed inputs. Set these to the Auth0 `sub` values of the two
# synthetic demo accounts before the one-time production seed. Never use real
# employee, client, or operational identities.
# SEED_OPERATIONS_MANAGER_SUBJECT=auth0|replace-with-synthetic-manager-subject
# SEED_AUDITOR_SUBJECT=auth0|replace-with-synthetic-auditor-subject

# Production must also set NODE_ENV=production, AUTH_MODE=oidc,
# ACCESS_STORE=prisma, an explicit DATABASE_URL, and HTTPS WEB_ORIGIN/OIDC_ISSUER
# values through the selected host's secret/configuration system.
